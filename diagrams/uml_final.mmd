classDiagram
    class Task {
        +str description
        +str time
        +str frequency
        +bool completed
        +date due_date
        +mark_complete()
        +next_occurrence()
    }
    class Pet {
        +str name
        +str species
        +List~Task~ tasks
        +add_task(task)
        +get_tasks()
    }
    class Owner {
        +str name
        +List~Pet~ pets
        +add_pet(pet)
        +get_all_tasks()
    }
    class Scheduler {
        +Owner owner
        +sort_by_time()
        +filter_tasks()
        +complete_task(task)
        +find_conflicts()
    }
    Owner "1" o-- "0..*" Pet : manages
    Pet "1" o-- "0..*" Task : contains
    Scheduler --> Owner : reads all tasks from
